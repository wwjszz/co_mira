@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(NOT TARGET PkgConfig::CO_MIRA_LIBURING)
  find_dependency(PkgConfig)
  pkg_check_modules(
    CO_MIRA_LIBURING
    REQUIRED
    IMPORTED_TARGET
    liburing
  )
endif()

include("${CMAKE_CURRENT_LIST_DIR}/co_miraTargets.cmake")

check_required_components(co_mira)
